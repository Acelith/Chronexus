{
  "name": "chronexus",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts eslint.config.js vite.config.ts tsconfig.json index.html",
    "format:check": "prettier --check src scripts eslint.config.js vite.config.ts tsconfig.json index.html",
    "lint": "eslint src",
    "test": "vitest run",
    "test:automation": "node --test scripts/automation/mcp-check.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "desktop": "pnpm icons && tauri dev",
    "build:desktop": "pnpm icons && tauri build --no-bundle",
    "icons": "tauri icon assets/chronexus.svg --output src-tauri/icons",
    "package:desktop": "pnpm icons && tauri build",
    "i18n:scan": "node scripts/i18n/scan.mjs",
    "i18n:normalize": "node scripts/i18n/prepare-catalogs.mjs",
    "i18n:check": "node scripts/i18n/prepare-catalogs.mjs --check && vitest run src/i18n/catalogs.test.ts"
  },
  "dependencies": {
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@mantine/core": "8.3.11",
    "@mantine/hooks": "8.3.11",
    "@tauri-apps/api": "^2.12.4",
    "cytoscape": "^3.34.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "opencc-js": "1.4.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
