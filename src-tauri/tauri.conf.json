{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronexus",
  "version": "0.4.0",
  "identifier": "it.nodex.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chronexus",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src https://api.open5e.com https://www.dnd5eapi.co ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'",
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src https://api.open5e.com https://www.dnd5eapi.co ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "resources": {
      "../scripts/ai/train.py": "ai/train.py",
      "../scripts/automation/mcp.mjs": "automation/mcp.mjs",
      "../LICENSE": "licenses/Chronexus-LICENSE.txt",
      "../assets/dice/README.md": "licenses/assets/dice/README.md",
      "../assets/fonts/cinzel-OFL.txt": "licenses/assets/fonts/cinzel-OFL.txt",
      "../assets/fonts/ebgaramond-OFL.txt": "licenses/assets/fonts/ebgaramond-OFL.txt",
      "../assets/fonts/forgotten-realms/Dethek-OFL.txt": "licenses/assets/fonts/forgotten-realms/Dethek-OFL.txt",
      "../assets/fonts/forgotten-realms/Dethek-Readme.txt": "licenses/assets/fonts/forgotten-realms/Dethek-Readme.txt",
      "../assets/fonts/forgotten-realms/Espruar-OFL.txt": "licenses/assets/fonts/forgotten-realms/Espruar-OFL.txt",
      "../assets/fonts/forgotten-realms/Espruar-Readme.txt": "licenses/assets/fonts/forgotten-realms/Espruar-Readme.txt",
      "../assets/fonts/forgotten-realms/metadata.json": "licenses/assets/fonts/forgotten-realms/metadata.json",
      "../assets/fonts/forgotten-realms/README.md": "licenses/assets/fonts/forgotten-realms/README.md",
      "../assets/fonts/m10/Monocraft-OFL.txt": "licenses/assets/fonts/m10/Monocraft-OFL.txt",
      "../assets/fonts/m10/notosansarabic-OFL.txt": "licenses/assets/fonts/m10/notosansarabic-OFL.txt",
      "../assets/fonts/m10/notosansjp-OFL.txt": "licenses/assets/fonts/m10/notosansjp-OFL.txt",
      "../assets/fonts/m10/notosanskr-OFL.txt": "licenses/assets/fonts/m10/notosanskr-OFL.txt",
      "../assets/fonts/m10/notosanssc-OFL.txt": "licenses/assets/fonts/m10/notosanssc-OFL.txt",
      "../assets/fonts/m10/README.md": "licenses/assets/fonts/m10/README.md",
      "../assets/fonts/README.md": "licenses/assets/fonts/README.md",
      "../assets/gui/README.md": "licenses/assets/gui/README.md"
    },
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Diario personale di campagne GDR",
    "longDescription": "Gestisci appunti, scheda, inventario e conoscenze delle tue campagne in un archivio locale.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1NjM4RkVGNkJEMkNGQTcKUldTbno5SnI3NDlqOVhnRGtYR1doS2R2bTdoR0ZFQmppd3pRVTJESU5lcnRtMnE0NFRqQmpYd0MK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
